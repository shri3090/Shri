# GEMINI_API_KEY: Required for Gemini AI + Google Maps Grounding.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection string for Prisma ORM.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/genericmed?schema=public"

# PORT: HTTP port for the Express server (default 3001).
PORT=3001

# CORS_ORIGIN: Allowed frontend origin (default http://localhost:5173).
CORS_ORIGIN="http://localhost:5173"
